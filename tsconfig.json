{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "*.ts",
    ".storybook/**/*.ts",
    "tests/**/*.ts",
    "scripts/local-identity.ts",
    "scripts/check-addition-family.ts",
    "scripts/check-review-benchmark.ts",
    "scripts/prepare-review-benchmark.ts",
    "scripts/check-model-access.ts",
    "scripts/run-live-review-smoke.ts",
    "scripts/run-expanded-benchmark.ts",
    "scripts/run-generator-benchmark.ts"
  ],
  "exclude": ["node_modules", "spikes", "storybook-static"]
}
