# Leave blank for foundation build/test/Storybook. Never use NEXT_PUBLIC_ for secrets.
# Future runtime: self-hosted PostgreSQL runtime role; migration role: separate owner credentials.
# Remote PostgreSQL URLs must use sslmode=verify-full. Do not paste real values into Git.
DATABASE_URL=
DIRECT_DATABASE_URL=
# D02 is disabled unless explicitly enabled for disposable loopback synthetic use.
# NEXO_LOCAL_IDENTITY=synthetic-only
# DATABASE_URL must name nexo_identity_local on 127.0.0.1; no URL query options.
NEXO_LOCAL_IDENTITY=
# D04 passkeys require an explicit http://localhost:3000 origin (IP-based RP IDs are rejected).
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
